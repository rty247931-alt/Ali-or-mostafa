# ---- Required (npm run setup fills these for you) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
SESSION_SECRET=""
SITE_URL="http://localhost:3000"

# ---- Product images (REQUIRED on Vercel; optional locally) ----
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_PUBLIC_URL="https://<public-bucket-domain>"

# ---- Email (password reset, email verification, order emails) ----
# RESEND_API_KEY=""
# MAIL_FROM="Store <orders@yourdomain.com>"

# ---- Online payment (Paymob). Then: Admin > Settings > test connection > enable ----
# PAYMOB_API_KEY=""
# PAYMOB_INTEGRATION_ID=""
# PAYMOB_IFRAME_ID=""
# PAYMOB_HMAC_SECRET=""

# ---- Development only ----
# SEED_DEMO=1          (adds one clearly-marked demo product to the seed)
# SMOKE_OK=1           (allows `npm run smoke`; never on a production database)
